# Kinship API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
SESSION_COOKIE_NAME=kinship_session
SESSION_TTL_DAYS=30
PASSWORD_PEPPER=replace-with-at-least-32-random-characters

# Use "memory" locally when HydraDB is unavailable, and "hydradb" in staging/production.
DATA_PROVIDER=memory

# HydraDB HTTP API (server-side only)
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_AUTH_TOKEN=replace-with-at-least-32-random-characters
HYDRADB_NAMESPACE=kinship
HYDRADB_GRAPH_ID=kinship
HYDRADB_CELL_ID=cell-0
HYDRADB_CONSISTENCY=causal

# Cloudinary unsigned uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kinship <noreply@example.com>

# HydraDB production object storage (configured on the HydraDB host, not Kinship API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
